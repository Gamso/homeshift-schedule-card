{
  "name": "HomeShift Schedule Card - Home Assistant",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // Ajout des DNS pour corriger l'erreur de connexion Copilot (getaddrinfo EAI_AGAIN)
  "runArgs": ["--dns=8.8.8.8", "--dns=1.1.1.1"],
  "appPort": ["8123:8123"],
  "forwardPorts": [8123],
  "portsAttributes": {
    "8123": {
      "label": "Home Assistant",
      "onAutoForward": "notify"
    }
  },
  // Home Assistant est le processus principal du conteneur (CMD du Dockerfile : start.sh) ;
  // VS Code ne doit pas le remplacer par sa boucle "sleep".
  "overrideCommand": false,
  // Installe les dépendances et prépare /config ; start.sh attend la fin de ce script.
  "postCreateCommand": "bash /workspaces/homeshift_schedule_card/.devcontainer/setup.sh",
  // Chemin fixe dans le conteneur, quel que soit le nom du dossier sur la machine.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/homeshift_schedule_card,type=bind",
  "workspaceFolder": "/workspaces/homeshift_schedule_card",
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/config,target=/config,type=bind",
    "source=${localWorkspaceFolder}/dist,target=/config/www/homeshift_schedule_card,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "remoteUser": "root"
}
